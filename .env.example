# Shown in the UI and used as the OBS/SRT path. Treat it like a password.
PUBLISH_KEY=change-me-to-a-long-random-string

# Admin UI (http://localhost:8080)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Hostname or IP the UI should display in OBS snippets.
# On the Oracle VM this is the public IP or your domain.
PUBLIC_HOST=localhost

# Internal. Leave as-is inside Docker Compose.
MEDIAMTX_API=http://mediamtx:9997
MEDIAMTX_RTMP=rtmp://mediamtx:1935
